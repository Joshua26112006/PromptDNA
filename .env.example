# ===========================================================================
# PromptDNA — Environment configuration (EXAMPLE)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for local development.
# NEVER commit a real `.env` file. NEVER put real secrets in this file.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins for the API (CORS).
# NEVER set this to "*" — credentials are enabled.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication (Phase 3) — JWT access tokens
# ---------------------------------------------------------------------------
# REQUIRED. Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# The API refuses to start if this is unset. Never commit a real secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Experiments / AI model execution (Phase 5)
# ---------------------------------------------------------------------------
# Server-side only. Never sent to the frontend, never logged, never returned.
# With no key set, models whose provider is "OpenAI" cannot be executed and the
# run endpoint responds 503 with a clear message (no experiment row is created).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Per-call timeout for a provider request (seconds). Dev default; production
# should tune this and add rate limiting + cost controls.
EXPERIMENT_PROVIDER_TIMEOUT_S=30
# Built-in deterministic provider (provider name "mock") for local dev/tests.
ENABLE_MOCK_PROVIDER=true

# ---------------------------------------------------------------------------
# Semantic search / embeddings (Phase 6) — needs a PostgreSQL with pgvector
# ---------------------------------------------------------------------------
# true  = versions.embedding is mapped, migration 0002 applies, /search/semantic works.
# false = embedding columns unmapped, semantic endpoints return 503 (lexical search
#         unaffected). Use false only where the `vector` extension is unavailable.
PGVECTOR_ENABLED=true
# Active embedding provider: "mock" (deterministic, dev/tests) or "openai".
EMBEDDING_PROVIDER=mock
# Fixed vector dimension. MUST match the provider AND the versions.embedding
# column set by migration 0002. 1536 = OpenAI text-embedding-3-small.
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL_NAME=text-embedding-3-small
# Best-effort embed right after a version is created (needs pgvector).
EMBEDDING_AUTOGENERATE=false

# ---------------------------------------------------------------------------
# PostgreSQL — system of record (relational data + pgvector embeddings)
# ---------------------------------------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://promptdna:promptdna@localhost:5432/promptdna

# ---------------------------------------------------------------------------
# Neo4j (Phase 7) — SUPPORTING graph projection of prompt relationships only.
# PostgreSQL stays the system of record. When NEO4J_ENABLED=false the graph
# endpoints return 503 and nothing else is affected.
# The docker-compose neo4j service uses auth  neo4j / promptdna_dev.
# ---------------------------------------------------------------------------
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Embedding provider — abstraction; provider is replaceable.
# The vector dimension is intentionally NOT set here. It will be derived from
# the embedding model chosen during the semantic-search phase.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Base URL the Next.js app uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
